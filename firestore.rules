rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function validOptionalString(data, field, maximum) {
      return !data.keys().hasAny([field])
        || (data[field] is string && data[field].size() <= maximum);
    }

    function validUserProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'displayName',
          'fullName',
          'phoneNumber',
          'deliveryAddress',
          'deliveryAddressMigrated',
          'updatedAt'
        ])
        && validOptionalString(data, 'displayName', 100)
        && validOptionalString(data, 'fullName', 100)
        && validOptionalString(data, 'phoneNumber', 30)
        && validOptionalString(data, 'deliveryAddress', 500)
        && (!data.keys().hasAny(['deliveryAddressMigrated'])
          || data.deliveryAddressMigrated is bool)
        && (!data.keys().hasAny(['updatedAt'])
          || data.updatedAt == request.time);
    }

    function validCartItem(productId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'productId',
          'name',
          'priceCents',
          'quantity',
          'updatedAt'
        ])
        && data.productId == productId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.priceCents is int
        && data.priceCents >= 0
        && data.quantity is int
        && data.quantity > 0
        && data.quantity <= 99
        && data.updatedAt == request.time;
    }

    function validWishlistItem(productId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['productId', 'createdAt'])
        && data.productId == productId
        && data.createdAt == request.time;
    }

    function validDeliveryAddress() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'label',
          'fullName',
          'phoneNumber',
          'address',
          'isDefault',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'label',
          'fullName',
          'phoneNumber',
          'address',
          'isDefault',
          'createdAt',
          'updatedAt'
        ])
        && data.label is string
        && data.label.size() > 0
        && data.label.size() <= 50
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 100
        && data.phoneNumber is string
        && data.phoneNumber.size() <= 30
        && data.address is string
        && data.address.size() >= 3
        && data.address.size() <= 500
        && data.isDefault is bool
        && data.updatedAt == request.time
        && (
          (request.method == 'create' && data.createdAt == request.time)
          || (
            request.method == 'update'
            && data.createdAt == resource.data.createdAt
          )
        );
    }

    function validDeviceRegistration() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'createdAt',
          'platform',
          'token',
          'updatedAt'
        ])
        && data.token is string
        && data.token.size() > 0
        && data.token.size() <= 4096
        && data.platform in ['android', 'ios']
        && data.updatedAt == request.time
        && (
          (request.method == 'create' && data.createdAt == request.time)
          || (
            request.method == 'update'
            && data.createdAt == resource.data.createdAt
          )
        );
    }

    match /users/{userId} {
      allow read: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId) && validUserProfile();
      allow delete: if false;

      match /cartItems/{productId} {
        allow read, delete: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId)
          && validCartItem(productId);
      }

      match /wishlistItems/{productId} {
        allow read, delete: if ownsUserData(userId);
        allow create: if ownsUserData(userId)
          && validWishlistItem(productId);
        allow update: if false;
      }

      match /deliveryAddresses/{addressId} {
        allow read, delete: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId)
          && validDeliveryAddress();
      }

      match /deviceRegistrations/{installationId} {
        allow read, delete: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId)
          && validDeviceRegistration();
      }

      match /orders/{orderId} {
        allow read: if ownsUserData(userId);
        allow create, update, delete: if false;
      }
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /reviews/{userId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }
    }
  }
}
